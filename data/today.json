        {
          "id": "aws-001",
          "title": "New in AWS Quick: More capable flows, an updated web experience, and agents that work together",
          "url": "https://aws.amazon.com/blogs/machine-learning/new-in-aws-quick-more-capable-flows-an-updated-web-experience-and-agents-that-work-together/",
          "thumbnail": "",
          "summary": "AWS Quick is the AI workspace built only for work. Today we’re releasing updates that help your team get more done: build and run business-process flows in chat, triage your day in the updated web app, get more complete answers from multiple agents at once, and connect new data sources like Meta ads and Amplitude.",
          "tags": [
            "AI"
          ],
          "publishedAt": "2026-11-21T01:06:42.000Z",
          "publishedAtRelative": "20小时前"
        },
        {
          "id": "aws-002",
          "title": "Cut self-hosted LLM cost and latency with the distributed KV caching agent skill",
          "url": "https://aws.amazon.com/blogs/machine-learning/cut-self-hosted-llm-cost-and-latency-with-the-distributed-kv-caching-agent-skill/",
          "thumbnail": "",
          "summary": "Self-hosting LLMs on GPUs means paying to recompute the same context on every turn. Distributed KV caching with Amazon ElastiCache can cut inference cost by up to 40% and time to first token by up to 80%. This post walks through the distributed KV caching skill in the Agent Toolkit for AWS, which evaluates and sets up the cache from your coding agent.",
          "tags": [
            "工具"
          ],
          "publishedAt": "2026-11-21T00:14:26.000Z",
          "publishedAtRelative": "21小时前"
        },
        {
          "id": "aws-003",
          "title": "Introducing managed cluster extensions for observability and user management in Amazon SageMaker HyperPod Slurm",
          "url": "https://aws.amazon.com/blogs/machine-learning/introducing-managed-cluster-extensions-for-observability-and-user-management-in-amazon-sagemaker-hyperpod-slurm/",
          "thumbnail": "",
          "summary": "Amazon SageMaker HyperPod now offers managed cluster extensions for observability and user management, bringing declarative, API- and console-driven configuration to the software running on Slurm cluster nodes. This post explains how the extensions work and follows a platform team through a quarter of running a shared Slurm cluster with them.",
          "tags": [
            "AI"
          ],
          "publishedAt": "2026-11-20T23:07:03.000Z",
          "publishedAtRelative": "22小时前"
        },
        {
          "id": "aws-004",
          "title": "Introducing Amazon SageMaker HyperPod Global Inference Gateway: One endpoint across Regions and clusters",
          "url": "https://aws.amazon.com/blogs/machine-learning/introducing-amazon-sagemaker-hyperpod-global-inference-gateway-one-endpoint-across-regions-and-clusters/",
          "thumbnail": "",
          "summary": "Amazon SageMaker HyperPod introduces the Global Inference Gateway, one managed endpoint that routes inference requests across your HyperPod clusters in one Region or across Regions. It picks the best cluster, fails over automatically, and authenticates every request with SigV4 and IAM over AWS PrivateLink.",
          "tags": [
            "AI"
          ],
          "publishedAt": "2026-11-20T22:35:24.000Z",
          "publishedAtRelative": "22小时前"
        },
